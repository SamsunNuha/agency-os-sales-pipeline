# Agency OS — Sales Pipeline & Deal Management
# Backend Environment Variables
# Copy this file to .env and fill in real values. NEVER commit .env.

# ──────────────────────────────────────────────
# APPLICATION
# ──────────────────────────────────────────────
PORT=5001
NODE_ENV=development

# ──────────────────────────────────────────────
# DATABASE (Matches docker-compose.yml defaults)
# ──────────────────────────────────────────────
DATABASE_URL="postgresql://agency_os_user:changeme_in_env@localhost:5432/agency_os_sales?schema=public"
POSTGRES_DB=agency_os_sales
POSTGRES_USER=agency_os_user
POSTGRES_PASSWORD=changeme_in_env
POSTGRES_PORT=5432

# ──────────────────────────────────────────────
# JWT
# ──────────────────────────────────────────────
# Generate: node -e "require('crypto').randomBytes(64).toString('hex')"
JWT_SECRET=replace_with_a_secure_random_64_byte_hex_string
JWT_EXPIRES_IN=7d

# ──────────────────────────────────────────────
# CORS
# ──────────────────────────────────────────────
FRONTEND_URL=http://localhost:3000

# ──────────────────────────────────────────────
# PGADMIN (optional, dev only)
# ──────────────────────────────────────────────
PGADMIN_EMAIL=admin@agency-os.local
PGADMIN_PASSWORD=changeme_in_env
PGADMIN_PORT=5050

# ──────────────────────────────────────────────
# SEED / DEMO (dev only)
# ──────────────────────────────────────────────
SEED_ADMIN_EMAIL=admin@agency-os.local
SEED_ADMIN_PASSWORD=Admin@1234
