// Prisma Schema — Agency OS Sales Pipeline & Deal Management
// PostgreSQL + Prisma 5
// All monetary values: Decimal(15,2) — never Float
// All currency codes: ISO 4217 String(3)
// All IDs: UUID

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// ─────────────────────────────────────────────────────────────────────────────
// ENUMS
// ─────────────────────────────────────────────────────────────────────────────

enum DealState {
  ACTIVE
  WON
  LOST
  ARCHIVED
}

enum FollowUpStatus {
  UPCOMING
  OVERDUE
  COMPLETED
  RESCHEDULED
}

enum ActivityType {
  DEAL_CREATED
  STAGE_CHANGE
  NOTE_ADDED
  FOLLOW_UP_SCHEDULED
  FOLLOW_UP_COMPLETED
  FOLLOW_UP_RESCHEDULED
  DEAL_WON
  DEAL_LOST
  DEAL_ARCHIVED
  DEAL_REOPENED
  PROBABILITY_UPDATED
  HANDOFF_INITIATED
}

// ─────────────────────────────────────────────────────────────────────────────
// AGENCY
// ─────────────────────────────────────────────────────────────────────────────

model Agency {
  id        String   @id @default(uuid())
  name      String
  slug      String   @unique
  isActive  Boolean  @default(true)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  users         User[]
  clients       Client[]
  pipelines     SalesPipeline[]
  deals         Deal[]
  stages        PipelineStage[]
  followUps     DealFollowUp[]
  activities    DealActivity[]
  stageHistory  DealStageHistory[]
  intelligence  DealIntelligence[]

  @@map("agencies")
}

// ─────────────────────────────────────────────────────────────────────────────
// USER & ROLE
// ─────────────────────────────────────────────────────────────────────────────

model Role {
  id          String   @id @default(uuid())
  agencyId    String
  name        String
  permissions String[]
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  users       UserRole[]

  @@unique([agencyId, name])
  @@map("roles")
}

model User {
  id           String   @id @default(uuid())
  agencyId     String
  email        String   @unique
  passwordHash String
  firstName    String
  lastName     String
  isActive     Boolean  @default(true)
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  agency        Agency            @relation(fields: [agencyId], references: [id])
  roles         UserRole[]
  ownedDeals    Deal[]            @relation("DealOwner")
  stageHistory  DealStageHistory[]
  followUps     DealFollowUp[]
  activities    DealActivity[]

  @@index([agencyId])
  @@map("users")
}

model UserRole {
  userId    String
  roleId    String
  createdAt DateTime @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)
  role Role @relation(fields: [roleId], references: [id], onDelete: Cascade)

  @@id([userId, roleId])
  @@map("user_roles")
}

// ─────────────────────────────────────────────────────────────────────────────
// CLIENT
// ─────────────────────────────────────────────────────────────────────────────

model Client {
  id        String   @id @default(uuid())
  agencyId  String
  name      String
  email     String?
  phone     String?
  company   String?
  isActive  Boolean  @default(true)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  agency Agency @relation(fields: [agencyId], references: [id])
  deals  Deal[]

  @@index([agencyId])
  @@map("clients")
}

// ─────────────────────────────────────────────────────────────────────────────
// PIPELINE & STAGE
// ─────────────────────────────────────────────────────────────────────────────

model SalesPipeline {
  id          String   @id @default(uuid())
  agencyId    String
  name        String
  description String?
  isActive    Boolean  @default(true)
  isDefault   Boolean  @default(false)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  agency Agency          @relation(fields: [agencyId], references: [id])
  stages PipelineStage[]
  deals  Deal[]

  @@index([agencyId])
  @@map("sales_pipelines")
}

model PipelineStage {
  id          String   @id @default(uuid())
  pipelineId  String
  agencyId    String
  name        String
  slug        String
  order       Int
  probability Int      @default(50)
  isWon       Boolean  @default(false)
  isLost      Boolean  @default(false)
  color       String   @default("#2563EB")
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  pipeline    SalesPipeline      @relation(fields: [pipelineId], references: [id])
  agency      Agency             @relation(fields: [agencyId], references: [id])
  deals       Deal[]
  fromHistory DealStageHistory[] @relation("FromStage")
  toHistory   DealStageHistory[] @relation("ToStage")

  @@unique([pipelineId, slug])
  @@unique([pipelineId, order])
  @@index([agencyId])
  @@index([pipelineId])
  @@map("pipeline_stages")
}

// ─────────────────────────────────────────────────────────────────────────────
// DEAL
// ─────────────────────────────────────────────────────────────────────────────

model Deal {
  id                String    @id @default(uuid())
  agencyId          String
  clientId          String
  title             String
  description       String?
  serviceCategory   String
  expectedValue     Decimal   @db.Decimal(15, 2)
  currency          String    @db.Char(3)
  ownerId           String
  pipelineId        String
  stageId           String
  expectedCloseDate DateTime
  state             DealState @default(ACTIVE)
  manualProbability Int?
  notes             String?
  tags              String[]  @default([])
  source            String?
  wonAt             DateTime?
  lostAt            DateTime?
  lostReason        String?
  lostNote          String?
  archivedAt        DateTime?
  handedOffAt       DateTime?
  createdAt         DateTime  @default(now())
  updatedAt         DateTime  @updatedAt

  agency       Agency             @relation(fields: [agencyId], references: [id])
  client       Client             @relation(fields: [clientId], references: [id])
  owner        User               @relation("DealOwner", fields: [ownerId], references: [id])
  pipeline     SalesPipeline      @relation(fields: [pipelineId], references: [id])
  stage        PipelineStage      @relation(fields: [stageId], references: [id])
  stageHistory DealStageHistory[]
  followUps    DealFollowUp[]
  activities   DealActivity[]
  intelligence DealIntelligence?

  @@index([agencyId])
  @@index([stageId])
  @@index([pipelineId])
  @@index([ownerId])
  @@index([clientId])
  @@index([state])
  @@index([expectedCloseDate])
  @@map("deals")
}

// ─────────────────────────────────────────────────────────────────────────────
// DEAL STAGE HISTORY
// ─────────────────────────────────────────────────────────────────────────────

model DealStageHistory {
  id          String   @id @default(uuid())
  dealId      String
  agencyId    String
  fromStageId String?
  toStageId   String
  movedById   String
  note        String?
  createdAt   DateTime @default(now())

  deal      Deal           @relation(fields: [dealId], references: [id], onDelete: Cascade)
  agency    Agency         @relation(fields: [agencyId], references: [id])
  fromStage PipelineStage? @relation("FromStage", fields: [fromStageId], references: [id])
  toStage   PipelineStage  @relation("ToStage", fields: [toStageId], references: [id])
  movedBy   User           @relation(fields: [movedById], references: [id])

  @@index([dealId])
  @@index([agencyId])
  @@map("deal_stage_history")
}

// ─────────────────────────────────────────────────────────────────────────────
// DEAL FOLLOW-UP
// ─────────────────────────────────────────────────────────────────────────────

model DealFollowUp {
  id              String         @id @default(uuid())
  dealId          String
  agencyId        String
  scheduledAt     DateTime
  completedAt     DateTime?
  rescheduledAt   DateTime?
  note            String
  status          FollowUpStatus @default(UPCOMING)
  createdById     String
  createdAt       DateTime       @default(now())
  updatedAt       DateTime       @updatedAt

  deal      Deal   @relation(fields: [dealId], references: [id], onDelete: Cascade)
  agency    Agency @relation(fields: [agencyId], references: [id])
  createdBy User   @relation(fields: [createdById], references: [id])

  @@index([dealId])
  @@index([agencyId])
  @@index([scheduledAt])
  @@index([status])
  @@map("deal_follow_ups")
}

// ─────────────────────────────────────────────────────────────────────────────
// DEAL ACTIVITY
// ─────────────────────────────────────────────────────────────────────────────

model DealActivity {
  id            String       @id @default(uuid())
  dealId        String
  agencyId      String
  activityType  ActivityType
  description   String
  metadata      Json         @default("{}")
  performedById String
  createdAt     DateTime     @default(now())

  deal        Deal   @relation(fields: [dealId], references: [id], onDelete: Cascade)
  agency      Agency @relation(fields: [agencyId], references: [id])
  performedBy User   @relation(fields: [performedById], references: [id])

  @@index([dealId])
  @@index([agencyId])
  @@index([activityType])
  @@map("deal_activities")
}

// ─────────────────────────────────────────────────────────────────────────────
// DEAL INTELLIGENCE (Probability + Stalled Detection)
// ─────────────────────────────────────────────────────────────────────────────

model DealIntelligence {
  id                     String   @id @default(uuid())
  dealId                 String   @unique
  agencyId               String
  calculatedProbability  Int      @default(0)
  probabilitySignals     Json     @default("{}")
  calculationVersion     String   @default("v1.0-rule-based")
  isStalled              Boolean  @default(false)
  stalledAt              DateTime?
  inactiveDays           Int      @default(0)
  lastActivityAt         DateTime?
  stalledReason          String?
  recalculatedAt         DateTime @default(now())
  createdAt              DateTime @default(now())
  updatedAt              DateTime @updatedAt

  deal   Deal   @relation(fields: [dealId], references: [id], onDelete: Cascade)
  agency Agency @relation(fields: [agencyId], references: [id])

  @@index([agencyId])
  @@index([isStalled])
  @@map("deal_intelligence")
}
